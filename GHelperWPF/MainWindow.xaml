<Window x:Class="GHelperWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G-HELPER  //  ROG EDITION" Height="680" Width="1100"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MinWidth="900" MinHeight="600">

    <Window.Resources>
        <!-- ═══════════ COLOR PALETTE ═══════════ -->
        <Color x:Key="ClrBgDeep">#0A0A0A</Color>
        <Color x:Key="ClrBgDark">#111111</Color>
        <Color x:Key="ClrBgMid">#1A1A1A</Color>
        <Color x:Key="ClrBgCard">#1E1E1E</Color>
        <Color x:Key="ClrBgHover">#2A2A2A</Color>
        <Color x:Key="ClrAccent">#FF0033</Color>
        <Color x:Key="ClrAccentGlow">#FF3355</Color>
        <Color x:Key="ClrTextPrimary">#E8E8E8</Color>
        <Color x:Key="ClrTextSecondary">#888888</Color>
        <Color x:Key="ClrGreen">#00CC66</Color>
        <Color x:Key="ClrYellow">#FFAA00</Color>
        <Color x:Key="ClrCyan">#00BBCC</Color>
        <Color x:Key="ClrBorder">#2A2A2A</Color>

        <SolidColorBrush x:Key="BgDeep" Color="{StaticResource ClrBgDeep}" />
        <SolidColorBrush x:Key="BgDark" Color="{StaticResource ClrBgDark}" />
        <SolidColorBrush x:Key="BgMid" Color="{StaticResource ClrBgMid}" />
        <SolidColorBrush x:Key="BgCard" Color="{StaticResource ClrBgCard}" />
        <SolidColorBrush x:Key="BgHover" Color="{StaticResource ClrBgHover}" />
        <SolidColorBrush x:Key="AccentRed" Color="{StaticResource ClrAccent}" />
        <SolidColorBrush x:Key="AccentGlow" Color="{StaticResource ClrAccentGlow}" />
        <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource ClrTextPrimary}" />
        <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource ClrTextSecondary}" />
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource ClrGreen}" />
        <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource ClrYellow}" />
        <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource ClrCyan}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ClrBorder}" />

        <!-- ═══════════ NAV BUTTON STYLE ═══════════ -->
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="indicator" Grid.Column="0" Width="3" Background="Transparent" CornerRadius="1" Margin="0,2"/>
                                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="indicator" Property="Background" Value="{StaticResource AccentRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ MODE BUTTON STYLE ═══════════ -->
        <Style TargetType="RadioButton" x:Key="ModeButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="modeBorder" Background="{StaticResource BgMid}" 
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="16,14" MinWidth="120">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="modeIcon" Text="{TemplateBinding Tag}" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="modeBorder" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                <Setter TargetName="modeBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#2A0010" Offset="0"/>
                                            <GradientStop Color="#1A1A1A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="modeIcon" Property="Foreground" Value="{StaticResource AccentRed}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="modeBorder" Property="BorderBrush" Value="{StaticResource AccentGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ CARD BORDER STYLE ═══════════ -->
        <Style TargetType="Border" x:Key="CardBorder">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- ═══════════ SECTION HEADER STYLE ═══════════ -->
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- ═══════════ STAT VALUE STYLE ═══════════ -->
        <Style TargetType="TextBlock" x:Key="StatValue">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="StatUnit">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="StatLabel">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- ═══════════ TITLE BAR BUTTON ═══════════ -->
        <Style TargetType="Button" x:Key="TitleBarBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource BgHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="TitleBarCloseBtn" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentRed}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ TOGGLE SWITCH STYLE ═══════════ -->
        <Style TargetType="CheckBox" x:Key="ToggleSwitch">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="#333333" Grid.Column="0">
                                <Border x:Name="thumb" Width="16" Height="16" CornerRadius="8" Background="#888888"
                                        HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentRed}"/>
                                <Setter TargetName="thumb" Property="Background" Value="White"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ SLIDER STYLE ═══════════ -->
        <Style TargetType="Slider" x:Key="AccentSlider">
            <Setter Property="Minimum" Value="40"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="10"/>
        </Style>

    </Window.Resources>

    <!-- ═══════════ MAIN CHROME ═══════════ -->
    <Border CornerRadius="10" ClipToBounds="True"
            BorderBrush="#222222" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0A0A" Offset="0"/>
                <GradientStop Color="#111111" Offset="0.5"/>
                <GradientStop Color="#0D0D0D" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ CUSTOM TITLE BAR ═══════════ -->
            <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1A1A1A" Offset="0"/>
                        <GradientStop Color="#151515" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- Red accent line at the very top -->
                <Border Height="2" VerticalAlignment="Top" CornerRadius="10,10,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0033" Offset="0"/>
                            <GradientStop Color="#CC0022" Offset="0.5"/>
                            <GradientStop Color="#FF0033" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="G" Foreground="{StaticResource AccentRed}" FontWeight="ExtraBold" FontSize="16"/>
                    <TextBlock Text="-HELPER" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14" Margin="1,1,0,0"/>
                    <TextBlock Text="  //  ROG EDITION" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center" Margin="8,2,0,0"/>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,8,0">
                    <Button Content="—" Style="{StaticResource TitleBarBtn}" Click="Minimize_Click"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseBtn}" Click="Close_Click" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ═══════════ BODY ═══════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════ SIDEBAR ═══════════ -->
                <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#141414" Offset="0"/>
                            <GradientStop Color="#0E0E0E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="0,16,0,0">
                        <Button Content="⚡  Dashboard" Style="{StaticResource NavButton}"/>
                        <Button Content="🖥  Device" Style="{StaticResource NavButton}"/>
                        <Button Content="🌈  Aura Sync" Style="{StaticResource NavButton}"/>
                        <Button Content="🎮  Game Profile" Style="{StaticResource NavButton}"/>
                        <Button Content="⚙  Settings" Style="{StaticResource NavButton}"/>

                        <!-- Bottom spacer + version -->
                        <TextBlock Text="v0.1.0" Foreground="#333333" FontSize="10" Margin="24,220,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════ MAIN CONTENT ═══════════ -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                    <StackPanel Margin="24,20,24,24">

                        <!-- ─── SECTION: PERFORMANCE MODES ─── -->
                        <TextBlock Text="PERFORMANCE MODE" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <RadioButton x:Name="rbSilent" GroupName="PerfMode" Tag="🔇" Content="SILENT" Style="{StaticResource ModeButton}" Margin="0,0,10,0"/>
                            <RadioButton x:Name="rbBalanced" GroupName="PerfMode" Tag="⚖" Content="BALANCED" Style="{StaticResource ModeButton}" IsChecked="True" Margin="0,0,10,0"/>
                            <RadioButton x:Name="rbTurbo" GroupName="PerfMode" Tag="🔥" Content="TURBO" Style="{StaticResource ModeButton}" Margin="0,0,10,0"/>
                        </StackPanel>

                        <!-- ─── SECTION: SYSTEM MONITORING ─── -->
                        <TextBlock Text="SYSTEM MONITORING" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CPU Temp -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="CPU TEMP" Style="{StaticResource StatLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock x:Name="txtCpuTemp" Text="--" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentRed}"/>
                                        <TextBlock Text="°C" Style="{StaticResource StatUnit}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- GPU Temp -->
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="GPU TEMP" Style="{StaticResource StatLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock x:Name="txtGpuTemp" Text="--" Style="{StaticResource StatValue}" Foreground="{StaticResource YellowBrush}"/>
                                        <TextBlock Text="°C" Style="{StaticResource StatUnit}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- CPU Fan -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="4,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="CPU FAN" Style="{StaticResource StatLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock x:Name="txtCpuFan" Text="--" Style="{StaticResource StatValue}" Foreground="{StaticResource CyanBrush}"/>
                                        <TextBlock Text="RPM" Style="{StaticResource StatUnit}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- GPU Fan -->
                            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="GPU FAN" Style="{StaticResource StatLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock x:Name="txtGpuFan" Text="--" Style="{StaticResource StatValue}" Foreground="{StaticResource GreenBrush}"/>
                                        <TextBlock Text="RPM" Style="{StaticResource StatUnit}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ─── BOTTOM ROW: GPU MODE + BATTERY + DISPLAY ─── -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- GPU Mode -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="GPU MODE" Style="{StaticResource SectionHeader}"/>

                                    <RadioButton x:Name="rbEco" GroupName="GpuMode" Margin="0,0,0,8" Foreground="{StaticResource TextPrimary}" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🌿" FontSize="14" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Eco Mode" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="iGPU only, saves power" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="rbStandard" GroupName="GpuMode" IsChecked="True" Margin="0,0,0,8" Foreground="{StaticResource TextPrimary}" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Standard" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="Hybrid, automatic switching" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="rbUltimate" GroupName="GpuMode" Margin="0,0,0,0" Foreground="{StaticResource TextPrimary}" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🚀" FontSize="14" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Ultimate (MUX)" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="dGPU direct, requires reboot" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <!-- Battery -->
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="BATTERY" Style="{StaticResource SectionHeader}"/>

                                    <TextBlock Text="Charge Limit" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="sliderBatteryLimit" Grid.Column="0" Style="{StaticResource AccentSlider}" Value="80" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtBatteryLimit" Grid.Column="1" Text="80%" Foreground="{StaticResource AccentRed}" FontSize="18" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Separator Background="#2A2A2A" Margin="0,16,0,12"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Battery Health:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        <TextBlock x:Name="txtBatteryHealth" Text="--%" Foreground="{StaticResource GreenBrush}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Discharge Rate:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        <TextBlock x:Name="txtDischargeRate" Text="-- W" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Display -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="DISPLAY" Style="{StaticResource SectionHeader}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <CheckBox x:Name="chkHighRefresh" Style="{StaticResource ToggleSwitch}" IsChecked="True">
                                            <TextBlock Text="High Refresh Rate" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                                        </CheckBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <CheckBox x:Name="chkOverdrive" Style="{StaticResource ToggleSwitch}">
                                            <TextBlock Text="Panel Overdrive" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                                        </CheckBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <CheckBox x:Name="chkFNLock" Style="{StaticResource ToggleSwitch}" IsChecked="True">
                                            <TextBlock Text="FN Lock" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                                        </CheckBox>
                                    </StackPanel>

                                    <Separator Background="#2A2A2A" Margin="0,2,0,12"/>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Current:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        <TextBlock x:Name="txtRefreshRate" Text="165 Hz" Foreground="{StaticResource CyanBrush}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
